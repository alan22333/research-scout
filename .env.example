# ============================================================
# Research Scout local environment template
# Copy to .env and fill the secret values locally.
# Never commit .env or paste real credentials into Git.
#
# 当前阶段准备清单：
#   1. ZOTERO_API_KEY 或 ZOTERO_API_KEY_FILE + ZOTERO_LIBRARY_ID
#   2. S2_API_KEY
#   3. DASHSCOPE_API_KEY（需支持 compatible-mode 和 enable_search）
#   4. OPENALEX_EMAIL（邮箱，不是 API Key）
#
# 阶段 4 再准备：
#   LLM_API_KEY、EMBEDDING_API_KEY、RERANK_API_KEY
# ============================================================

# --- Runtime ---
APP_ENV=local
HTTP_ADDR=:8080
AUTO_MIGRATE=true
DEV_AUTH_ENABLED=true
DEV_ACTOR_ID=local-user
DEV_WORKSPACE_ID=local-workspace
DATABASE_URL=postgres://research:research@localhost:55433/research_scout?sslmode=disable

# Local encryption key for stored Zotero credentials.
# Generate once with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-local-secret

# --- Zotero Web API ---
ZOTERO_API_BASE=https://api.zotero.org
ZOTERO_API_VERSION=3
ZOTERO_REQUEST_CONCURRENCY=4
ZOTERO_LIBRARY_ID=
# Option A: put the read-only Zotero API key here.
ZOTERO_API_KEY=
# Option B (recommended): point to a chmod 600 file containing the key.
ZOTERO_API_KEY_FILE=

# --- Stage 3: external scholarly discovery ---
# Keep disabled unless you intentionally want live external calls.
DISCOVERY_ENABLED=false
WEB_SEARCH_ENABLED=false
DISCOVERY_TIMEOUT=20s
S2_REQUESTS_PER_SECOND=1

# Semantic Scholar Graph API key.
S2_API_KEY=

# Email used for the OpenAlex polite pool. Not an API key.
OPENALEX_EMAIL=

# Qwen/DashScope provider-native web search.
# This key must be enabled for the compatible-mode API and support enable_search.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_SEARCH_MODEL=qwen-plus

# --- Stage 4 reserved: real generation, embedding and rerank ---
# These are not wired into the application yet; prepare them for Stage 4.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-plus

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_DIM=1024
EMBEDDING_NORMALIZATION_VERSION=l2-v1
EMBEDDING_QUERY_INSTRUCTION=
EMBEDDING_PASSAGE_INSTRUCTION=
EMBEDDING_TRUNCATION_POLICY_VERSION=truncate-v1

# Stage 4 provider boundary; names are reserved for the next implementation slice.
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=qwen3-rerank
